generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String        @id @default(cuid())
  name          String
  email         String        @unique
  cnpj          String?       @unique
  telefone      String?
  password      String
  role          Role          @default(DESPACHANTE)
  tourVisto     Boolean       @default(false)
  primeiroLogin Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  Despachante   Despachante?
  auditLogs     AuditLog[]
  notifications Notification[]
}

model Despachante {
  id         String      @id @default(cuid())
  user       User        @relation(fields: [userId], references: [id])
  userId     String      @unique
  nome       String
  cnpj       String?     @unique
  motoristas Motorista[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model Motorista {
  id             String        @id @default(cuid())
  despachante    Despachante   @relation(fields: [despachanteId], references: [id])
  despachanteId  String
  nome           String
  cpf            String        @unique
  email          String?
  dataNascimento DateTime?
  sexo           String?
  identidade     String?
  orgaoEmissor   String?
  ufEmissor      String?
  telefone       String?
  cursoTipo      CursoTipo
  documentos     Documento[]
  certificados   Certificado[]
  solicitacoesCodigo SolicitacaoCodigo[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([despachanteId])
  @@index([cpf])
}

model Documento {
  id            String           @id @default(cuid())
  motorista     Motorista        @relation(fields: [motoristaId], references: [id])
  motoristaId   String
  tipo          DocumentoTipo
  filename      String
  path          String
  mimetype      String
  size          Int
  status        DocumentoStatus  @default(PENDENTE)
  motivoNegacao String?
  uploadedBy    String
  uploadedAt    DateTime         @default(now())
  reviewedBy    String?
  reviewedAt    DateTime?
  logs          LogDocumento[]

  @@unique([motoristaId, tipo])
  @@index([motoristaId])
  @@index([status])
}

model LogDocumento {
  id          String    @id @default(cuid())
  documento   Documento @relation(fields: [documentoId], references: [id])
  documentoId String
  acao        String
  adminId     String?
  observacao  String?
  createdAt   DateTime  @default(now())

  @@index([documentoId])
}

model Certificado {
  id          String    @id @default(cuid())
  motorista   Motorista @relation(fields: [motoristaId], references: [id])
  motoristaId String
  filename    String
  originalName String
  path        String
  mimetype    String
  size        Int
  enviadoPor  String    // ID do admin que enviou
  enviadoEm   DateTime  @default(now())
  baixadoEm   DateTime? // Quando o despachante baixou

  @@index([motoristaId])
  @@index([enviadoEm])
}

enum Role {
  ADMIN
  DESPACHANTE
}

enum CursoTipo {
  TAC
  RT
}

enum DocumentoTipo {
  CNH
  COMPROVANTE_PAGAMENTO
  DOCUMENTO1
  DOCUMENTO2
}

enum DocumentoStatus {
  PENDENTE
  APROVADO
  NEGADO
}

// Parceiros e Solicitações de Parceria
enum ParceiroStatus {
  LEAD
  PARCEIRO
  REJEITADO
}

enum SolicitacaoStatus {
  PENDENTE
  APROVADO
  REJEITADO
}

model Parceiro {
  id        String         @id @default(cuid())
  cnpj      String         @unique
  empresa   String
  telefone  String?
  status    ParceiroStatus @default(LEAD)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model SolicitacaoCadastro {
  id           String            @id @default(cuid())
  cnpj         String
  empresa      String
  telefone     String
  email        String
  senha        String            // Senha hash para criar usuário na aprovação
  nomeResponsavel String?        // Nome do responsável pela empresa
  mensagem     String?
  status       SolicitacaoStatus @default(PENDENTE)
  analisadoPor String?
  observacoes  String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([cnpj, createdAt])
}

// Solicitações de Código
enum SolicitacaoCodigoStatus {
  PENDENTE
  ENVIADO
  CANCELADO
}

model SolicitacaoCodigo {
  id             String                   @id @default(cuid())
  motorista      Motorista                @relation(fields: [motoristaId], references: [id])
  motoristaId    String
  emailDestino   String                   // Email para onde o código será enviado
  observacao     String?                  // Observação do admin
  codigo         String?                  // Código enviado pelo despachante
  status         SolicitacaoCodigoStatus  @default(PENDENTE)
  solicitadoPor  String                   // ID do admin que solicitou
  solicitadoEm   DateTime                 @default(now())
  enviadoEm      DateTime?                // Quando o despachante enviou
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  @@index([motoristaId])
  @@index([status])
}

// Logs de Auditoria
model AuditLog {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  action      String   // LOGIN, LOGOUT, APROVAR_DOCUMENTO, NEGAR_DOCUMENTO, ENVIAR_CERTIFICADO, etc
  entityType  String?  // Motorista, Documento, Certificado, User, etc
  entityId    String?  // ID da entidade relacionada
  entityName  String?  // Nome/identificação da entidade para facilitar busca
  metadata    Json?    // Dados adicionais (ex: motivo de negação, dados anteriores, etc)
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
}

// Notificações
model Notification {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id])
  type        NotificationType
  title       String
  message     String
  read        Boolean          @default(false)
  entityType  String?          // Motorista, Documento, Certificado, Parceiro, etc
  entityId    String?          // ID da entidade relacionada
  metadata    Json?            // Dados adicionais
  createdAt   DateTime         @default(now())

  @@index([userId])
  @@index([read])
  @@index([createdAt])
  @@index([type])
}

enum NotificationType {
  DOCUMENTO_ENVIADO
  DOCUMENTO_APROVADO
  DOCUMENTO_NEGADO
  MOTORISTA_CRIADO
  SOLICITACAO_PARCEIRO
  SOLICITACAO_APROVADA
  SOLICITACAO_NEGADA
  CERTIFICADO_ENVIADO
  CERTIFICADO_BAIXADO
  USUARIO_CRIADO
  PASSWORD_RESET
}
